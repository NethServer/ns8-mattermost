# Mattermost 11 removed Bleve search. No -f: never remove a volume a container still uses.
if podman volume exists mattermost-bleve-indexes; then
    podman volume rm mattermost-bleve-indexes || echo "Cannot remove the mattermost-bleve-indexes volume" 1>&2
fi
